<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Klucze, które Xcode wstrzykuje sam przy GENERATE_INFOPLIST_FILE = YES.
       Tu plik jest pisany ręcznie, więc muszą być wprost — bez nich
       devicectl odrzuca paczkę jako nieprawidłową. -->
  <key>CFBundleDevelopmentRegion</key><string>pl</string>
  <!-- Adres magazynu; podmieniany flagą NORDO_URL przy budowaniu -->
  <key>NordoURL</key><string>$(NORDO_URL)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundleDisplayName</key><string>Nordo</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UILaunchScreen</key><dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
  <!-- Skanowanie kodów kreskowych przy kompletowaniu paczki -->
  <!-- Serwer deweloperski w sieci lokalnej chodzi po HTTP, nie HTTPS.
       Wyjątek dotyczy wyłącznie adresów prywatnych — produkcja idzie po
       HTTPS i nie korzysta z tej furtki. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key><true/>
  </dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Połączenie z serwerem magazynu w sieci lokalnej podczas pracy nad aplikacją.</string>
  <key>NSCameraUsageDescription</key>
  <string>Aparat służy do skanowania kodów kreskowych przy pakowaniu zamówień.</string>
</dict>
</plist>
