# Klucze frontendu. Oba są publiczne i lądują w kodzie przeglądarki —
# dostępu pilnuje RLS, nie tajność tych wartości.
# Lokalnie: wypisuje je `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# SERVICE_ROLE_KEY omija RLS. Nigdy w przeglądarce, nigdy w repozytorium —
# wyłącznie jako sekret Edge Functions.
