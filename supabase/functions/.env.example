# Sekrety funkcji Edge — skopiuj do `supabase/functions/.env` i uzupełnij.
# CLI ładuje ten plik automatycznie przy `supabase start`.
#
# Plik z prawdziwymi wartościami jest w .gitignore i ma tam zostać:
# klucz sekretny Stripe pozwala pobierać płatności w Twoim imieniu.
# Na produkcji tych wartości nie wgrywa się plikiem, tylko:
#   npx supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=...

# Klucz sekretny z panelu Stripe (Developers → API keys).
# Lokalnie WYŁĄCZNIE klucz testowy: sk_test_...
# Pusty = tryb bez płatności; zamówienie powstaje i czeka na opłacenie.
STRIPE_SECRET_KEY=

# Podpis webhooka. Lokalnie wypisuje go `stripe listen` (whsec_...),
# na produkcji panel Stripe przy endpoincie.
STRIPE_WEBHOOK_SECRET=

# Adres frontu — używany w adresach powrotu z bramki płatności i w nagłówku
# CORS funkcji create-checkout. Lokalnie serwer deweloperski Next.js.
SITE_URL=http://localhost:3000
