# Kopiuj do supabase/.env.local (lokalnie) albo wgraj jako sekrety projektu:
#   supabase secrets set --env-file supabase/.env.local

# Adres frontendu. Lokalnie serwer statyczny, później domena.
SITE_URL=http://127.0.0.1:8000
ADDITIONAL_REDIRECT_URL=http://127.0.0.1:8000

# Operator płatności. Pusty STRIPE_SECRET_KEY = tryb bez płatności:
# create-checkout tworzy zamówienie i zwraca checkout_url: null.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
