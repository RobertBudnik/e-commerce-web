# Zmienne czytane przez supabase/config.toml (`env(...)`) przy starcie stacku.
# To NIE są sekrety funkcji Edge — te leżą w supabase/functions/.env.example.
#
# Skrypty `npm run db:start` i `npm run db:reset` podstawiają wartości domyślne,
# więc lokalnie nie musisz tu nic robić. Plik przydaje się, gdy stack ma stanąć
# pod innym adresem — na przykład w Codespaces.

# Adres frontendu. Trafia do Site URL w Auth i do listy adresów powrotu;
# bez zgodności logowanie odbija w pustkę.
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URL=http://localhost:3000
