# Skopiuj do .env.local i uzupełnij wartościami swojego projektu.
# Lokalnie wypisuje je `npm run db:start` w katalogu nadrzędnym.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adres publiczny sklepu — trafia do metadanych OG i sitemapy.
# Na Vercelu można pominąć: VERCEL_PROJECT_PRODUCTION_URL wystarczy.
NEXT_PUBLIC_SITE_URL=

# Sentry. Puste = wyłączone; lokalnie nie ma czego zgłaszać.
# DSN jest publiczny z założenia — to adres projektu, nie sekret.
NEXT_PUBLIC_SENTRY_DSN=
# Rozdziela zgłoszenia produkcji od podglądów. Na Vercelu można pominąć.
NEXT_PUBLIC_SENTRY_ENV=

# Wyłącznie do wysyłki map źródeł przy buildzie. Token jest sekretem —
# ustawiasz go w panelu hostingu, nigdy w repozytorium.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
