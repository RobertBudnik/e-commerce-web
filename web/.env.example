# Skopiuj do .env.local i uzupełnij wartościami swojego projektu.
# Lokalnie wypisuje je `npm run db:start` w katalogu nadrzędnym.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adres publiczny sklepu — trafia do metadanych OG i sitemapy.
# Na Vercelu można pominąć: VERCEL_PROJECT_PRODUCTION_URL wystarczy.
NEXT_PUBLIC_SITE_URL=
