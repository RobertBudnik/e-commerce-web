# Skopiuj do .env.local i uzupełnij wartościami swojego projektu.
# Lokalnie wypisuje je `npm run db:start` w katalogu nadrzędnym.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adres publiczny sklepu — trafia do metadanych OG i sitemapy.
# Na Vercelu można pominąć: VERCEL_PROJECT_PRODUCTION_URL wystarczy.
NEXT_PUBLIC_SITE_URL=

# Sentry. Puste = wyłączone; lokalnie nie ma czego zgłaszać.
# DSN jest publiczny z założenia — to adres projektu, nie sekret.
NEXT_PUBLIC_SENTRY_DSN=
# Rozdziela zgłoszenia produkcji od podglądów. Na Vercelu można pominąć.
NEXT_PUBLIC_SENTRY_ENV=

# Wyłącznie do wysyłki map źródeł przy buildzie. Token jest sekretem —
# ustawiasz go w panelu hostingu, nigdy w repozytorium.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Poczta wychodząca (Resend) ---
# WYŁĄCZNIE po stronie serwera. Prefiks NEXT_PUBLIC_ wkłada wartość do paczki
# wysyłanej do przeglądarki — dla klucza API znaczyłoby to oddanie go każdemu,
# kto otworzy sklep.
#
# Maile Auth (potwierdzenie, reset, magic link) idą przez SMTP skonfigurowany
# w dashboardzie Supabase, nie tutaj. Poniższe dotyczy wyłącznie maila
# powitalnego, który wysyła Edge Function `mail-powitalny`.
# Te trzy ustawia się przez `supabase secrets set`, nie w tym pliku.
#
#   RESEND_API_KEY
#   RESEND_FROM
#   RESEND_REPLY_TO
#   SEKRET_POWITANIA
#   PUBLICZNY_ADRES
#
# Komplet instrukcji: docs/poczta-dns.md

# Pozycje poglądowe w sekcji „02 — Wybór" na stronie głównej.
# `1` pokazuje przykładowy towar, gdy katalog jest pusty — do oglądania układu
# lokalnie. NIGDY na produkcji: sklep, który wystawia wymyślony towar z ceną,
# okłamuje kupującego. Bez tej flagi sekcja pokazuje uczciwy stan pusty.
NEXT_PUBLIC_POKAZ_PRZYKLADY=
