{
  "name": "nordo-web",
  "private": true,
  "version": "0.1.0",
  "description": "Nordo — sklep na Next.js (App Router) z sesją w ciasteczkach",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:check": "NEXT_DIST_DIR=.next-build next build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "comment:overrides": "Next ciągnie własne postcss i sharp, oba z aktywnymi CVE. `npm audit fix` chciałby cofnąć Next do wersji 9 — zamiast tego podnosimy same zależności przechodnie. Do usunięcia, gdy Next podbije je u siebie.",
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
