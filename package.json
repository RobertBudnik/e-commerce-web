{
  "name": "sklep",
  "private": true,
  "version": "0.1.0",
  "description": "Sklep — Next.js (App Router) + Supabase",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck",
    "kontrast": "for m in jasny ciemny; do node scripts/kontrast.mjs --motyw $m || exit 1; done",
    "db:start": "SITE_URL=${SITE_URL:-http://localhost:3000} ADDITIONAL_REDIRECT_URL=${ADDITIONAL_REDIRECT_URL:-http://localhost:3000} supabase start",
    "db:stop": "supabase stop",
    "db:reset": "SITE_URL=${SITE_URL:-http://localhost:3000} ADDITIONAL_REDIRECT_URL=${ADDITIONAL_REDIRECT_URL:-http://localhost:3000} supabase db reset",
    "db:test": "node scripts/test-schema.mjs",
    "db:seed": "node scripts/gen-seed.mjs > supabase/seed.sql",
    "test:e2e": "npm --prefix web run test:e2e",
    "test:smoke": "npm --prefix web run test:smoke",
    "poczta:szablony": "node scripts/szablony-poczty.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "supabase": "^2.117.0"
  }
}
